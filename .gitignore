# 忽略巨大的模型权重文件（千万别传！）
weights/*.pt
weights/*.pth

# 忽略测试数据和输出的中间结果
data/inputs/
data/outputs/
data/manual/input/*
!data/manual/input/README.md
data/manual/output/*
!data/manual/output/README.md
qualisys/data/input/*
!qualisys/data/input/README.md
!qualisys/data/input/manifest.example.csv
!qualisys/data/input/marker_map.example.json
!qualisys/data/input/video/
!qualisys/data/input/qtm/
qualisys/data/input/video/*
!qualisys/data/input/video/README.md
qualisys/data/input/qtm/*
!qualisys/data/input/qtm/README.md
qualisys/data/intermediate/*
!qualisys/data/intermediate/README.md
qualisys/data/output/*
!qualisys/data/output/README.md

# 如果 Vue 文件夹里有前端依赖，也忽略掉（前端必备）
Vue/node_modules/

# Python 缓存和 IDE（比如 PyCharm）的配置文件
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
.venv/
.idea/
.vscode/
.agents/
.codex/

# 忽略个人的环境变量或敏感配置
.env
